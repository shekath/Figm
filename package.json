{
  "name": "figmy",
  "productName": "Figmy",
  "version": "1.0.0",
  "description": "Figmy - an open-source vector design, prototyping and real-time collaboration tool for web and desktop",
  "license": "MIT",
  "author": "Figmy contributors",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts --data ./.figmy-data",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server-dist/server.cjs --external:bufferutil --external:utf-8-validate --log-level=warning && esbuild server/app.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server-dist/app.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "start": "node server-dist/server.cjs --static dist",
    "mcp:stdio": "node server-dist/server.cjs --stdio",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.cjs",
    "electron:dev": "npm run build:server && concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "app.figmy.desktop",
    "productName": "Figmy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server-dist/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "figmy",
        "name": "Figmy Design",
        "role": "Editor"
      },
      {
        "ext": "vectura",
        "name": "Figmy Design (legacy)",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "immer": "^11.2.10",
    "jspdf": "^2.5.2",
    "nanoid": "^5.0.7",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1",
    "wrangler": "^4.158.0"
  },
  "bin": {
    "figmy-server": "server-dist/server.cjs"
  }
}
