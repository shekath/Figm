# Copy to .env (never commit .env) and fill in.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=https://figmy.your-domain.com
# Protects the API, collaboration and the MCP connector (also used by AI clients as a Bearer token).
FIGMY_TOKEN=change-me-to-a-long-random-string
# Optional: Sign in with Google
FIGMY_GOOGLE_CLIENT_ID=
FIGMY_REQUIRE_LOGIN=0
FIGMY_ALLOWED_DOMAINS=
FIGMY_ALLOWED_EMAILS=

# Optional: enables the Research Kit (AI personas, journey maps, sitemaps…) for everyone using this server.
# Without it, each user can add their own key in Research Kit → Settings.
ANTHROPIC_API_KEY=
