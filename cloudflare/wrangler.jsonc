{
  // Figmy server on Cloudflare Containers (needs the Workers Paid plan).
  // Deploy: see README → "Always-on in Cloudflare (Containers)".
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "figmy",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "containers": [
    {
      "class_name": "FigmyContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FIGMY", "class_name": "FigmyContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FigmyContainer"] }],
  "vars": {
    // public address people open, e.g. "https://app.example.com"
    "PUBLIC_URL": "",
    // R2 backup bucket (S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com)
    "FIGMY_S3_ENDPOINT": "",
    "FIGMY_S3_BUCKET": "figmy-data",
    "FIGMY_GOOGLE_CLIENT_ID": "",
    "FIGMY_REQUIRE_LOGIN": "1",
    "FIGMY_ALLOWED_DOMAINS": "",
    "FIGMY_ALLOWED_EMAILS": "",
    // container sleeps after this long without requests (wakes automatically on the next one)
    "SLEEP_AFTER": "2h"
  },
  "observability": { "enabled": true }
}
